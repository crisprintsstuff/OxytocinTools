# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Strongly recommended: a GitHub token (fine-grained, read-only "Contents" + "Metadata"
# on the repos you track, or a classic token with no scopes for public repos).
# Without it you are limited to 60 GitHub API requests/hour.
GITHUB_TOKEN=

# How often (seconds) to poll GitHub. Minimum 60.
POLL_INTERVAL=300

# Where the SQLite database lives.
DATABASE_PATH=data/tracker.db

# Comma-separated Discord user IDs that are always treated as bot admins (in every server).
BOT_OWNER_IDS=

# Optional: a server ID to sync slash commands to instantly while developing.
DEV_GUILD_ID=

LOG_LEVEL=INFO
