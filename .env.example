# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# --- GitHub access (recommended: a GitHub App; see README "GitHub App setup") ---
# The App ID from the app's settings page.
GITHUB_APP_ID=
# Path to the private key (.pem) you generated for the app.
GITHUB_APP_PRIVATE_KEY_PATH=data/github-app.pem
# ...or paste the key inline instead, with line breaks written as \n:
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Optional fallback: a personal access token, used for repos where the app isn't installed
# (e.g. other people's public repos) so they get 5000 requests/hour instead of 60.
# A classic token with no scopes is enough for that.
GITHUB_TOKEN=

# How often (seconds) to poll GitHub. Minimum 60.
POLL_INTERVAL=300

# Where the SQLite database lives.
DATABASE_PATH=data/tracker.db

# Comma-separated Discord user IDs that are always treated as bot admins (in every server).
BOT_OWNER_IDS=

# Seconds a non-admin must wait between creating issues (0 = no limit).
ISSUE_COOLDOWN=60

LOG_LEVEL=INFO
