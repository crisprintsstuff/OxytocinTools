# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Strongly recommended: a GitHub token. Create it on a dedicated GitHub account for the
# bot, because issues created from Discord will show that account as the author.
# Fine-grained token permissions: Metadata (read), Contents (read), Pull requests (read),
# Issues (read AND write to allow /issue create; read-only otherwise).
# Without a token you are limited to 60 GitHub API requests/hour and can't create issues.
GITHUB_TOKEN=

# How often (seconds) to poll GitHub. Minimum 60.
POLL_INTERVAL=300

# Where the SQLite database lives.
DATABASE_PATH=data/tracker.db

# Comma-separated Discord user IDs that are always treated as bot admins (in every server).
BOT_OWNER_IDS=

# Optional: a server ID to sync slash commands to instantly while developing.
DEV_GUILD_ID=

# Seconds a non-admin must wait between creating issues (0 = no limit).
ISSUE_COOLDOWN=60

LOG_LEVEL=INFO
